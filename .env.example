# Copy to .env. Never commit .env.

# Password of the database; any long random value.
POSTGRES_PASSWORD=

# The token the iPad sends with every sync request; any long random value, e.g. `openssl rand -base64 32`.
SYNC_TOKEN=

# Optional: timetable (iCal link), school news (RSS or Atom), a second place for encrypted backups and the passphrase for it, Paperless.
SCHOOL_TIMETABLE_ICS_URL=
SCHOOL_NEWS_FEED_URL=
# The timetable straight from WebUntis (when the school offers no iCal link): the server (before /WebUntis), the school name from the login address (school=...), her user and password.
UNTIS_SERVER=
UNTIS_SCHOOL=
UNTIS_USER=
UNTIS_PASSWORD=
BACKUP_COPY_TO=
BACKUP_PASSPHRASE=
PAPERLESS_BASE_URL=
PAPERLESS_TOKEN=

# Optional: use a released image instead of building one.
# JUNOTES_IMAGE=ghcr.io/juloc/junotes:latest
