@page
@{
    Layout = null;
}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JuNotes</title>
    <style>
        body { font: 17px/1.5 -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif; margin: 0; display: grid; min-height: 100vh; place-items: center; color: #1d1d1f; background: #fff; }
        @@media (prefers-color-scheme: dark) { body { color: #f5f5f7; background: #000; } }
        main { text-align: center; }
        h1 { font-weight: 600; letter-spacing: -0.02em; margin: 0 0 .25em; }
        p { margin: 0; opacity: .6; }
    </style>
</head>
<body>
    <main>
        <h1>JuNotes</h1>
        <p>Der Server läuft.</p>
    </main>
</body>
</html>
