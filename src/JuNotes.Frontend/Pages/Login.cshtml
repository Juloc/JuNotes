@page "/Login"
@model JuNotes.Frontend.Pages.ReaderLoginModel
@{
    Layout = "/Pages/Shared/_WebLayout.cshtml";
    ViewData["Title"] = "Anmelden";
}
<h1>Anmelden</h1>
@if (!Model.Enabled)
{
    <div class="card">
        <p><strong>Die Web-Ansicht ist noch aus.</strong></p>
        <p class="muted">Setze auf dem Server die Umgebungsvariable <code>Web__Password</code> auf ein langes Passwort und starte den Server neu.</p>
    </div>
}
else
{
    <form method="post" class="card" style="max-width:420px">
        @if (Model.Failure is not null)
        {
            <div class="notice">@Model.Failure</div>
        }
        <label for="password" class="muted">Passwort</label>
        <input id="password" name="password" type="password" autocomplete="current-password" autofocus />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <p><button class="primary" type="submit">Anmelden</button></p>
    </form>
}
