@{
    var title = ViewData["Title"] as string ?? "JuNotes";
}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="JuNotes" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <title>@title · JuNotes</title>
    <style>
        :root { color-scheme: light dark; --bg:#f2f2f7; --card:#fff; --text:#1c1c1e; --muted:#6c6c70; --line:#d1d1d6; --accent:#007aff; }
        @@media (prefers-color-scheme: dark) { :root { --bg:#000; --card:#1c1c1e; --text:#f5f5f7; --muted:#98989d; --line:#38383a; --accent:#0a84ff; } }
        * { box-sizing: border-box; }
        body { margin:0; font:16px/1.5 -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif; background:var(--bg); color:var(--text); }
        header { display:flex; gap:16px; align-items:center; padding:12px 20px; background:color-mix(in srgb, var(--card) 80%, transparent); backdrop-filter:blur(18px) saturate(1.6); -webkit-backdrop-filter:blur(18px) saturate(1.6); border-bottom:.5px solid var(--line); position:sticky; top:0; z-index:5; }
        header a { color:var(--text); text-decoration:none; }
        header strong { font-size:18px; }
        header .right { margin-left:auto; display:flex; gap:12px; align-items:center; }
        header button { font:inherit; background:none; border:0; color:var(--accent); cursor:pointer; padding:4px 8px; }
        main { max-width:1000px; margin:0 auto; padding:20px; }
        h1 { font-size:28px; margin:8px 0 18px; letter-spacing:-.02em; }
        h2 { font-size:19px; margin:26px 0 10px; display:flex; align-items:center; gap:8px; }
        .dot { width:12px; height:12px; border-radius:50%; display:inline-block; }
        .grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(170px, 1fr)); gap:16px; }
        .book { display:block; text-decoration:none; color:inherit; }
        .cover { aspect-ratio:.78; border-radius:10px; display:flex; align-items:flex-end; padding:12px; color:#fff; font-size:13px; box-shadow:0 1px 3px #0003; }
        .book strong { display:block; margin-top:8px; }
        .muted { color:var(--muted); font-size:14px; }
        input[type=search], input[type=password] { font:inherit; width:100%; padding:10px 12px; border-radius:10px; border:1px solid var(--line); background:var(--card); color:var(--text); }
        button.primary { font:inherit; font-weight:600; padding:9px 18px; border-radius:10px; border:0; background:var(--accent); color:#fff; cursor:pointer; }
        .card { background:var(--card); border-radius:14px; padding:18px 20px; box-shadow:0 0 0 .5px var(--line); }
        .notice { padding:10px 14px; border-radius:10px; background:color-mix(in srgb, #ff3b30 12%, transparent); margin-bottom:14px; }
        .page { position:relative; background:#fff; color:#000; border-radius:4px; box-shadow:0 1px 4px #0003; margin:0 auto 22px; container-type:inline-size; overflow:hidden; max-width:820px; }
        .page svg { display:block; width:100%; height:auto; position:relative; }
        .page img.scan { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; }
        .page .heading { position:absolute; left:12cqw; top:2cqw; font-size:2.3cqw; color:#737373; }
        .page .printed { position:absolute; left:12cqw; right:6cqw; top:7cqw; font-size:2.5cqw; white-space:pre-wrap; }
        .page .additions { position:absolute; left:2cqw; right:2cqw; bottom:2cqw; font-size:2.2cqw; padding:1.5cqw; background:#e1f5e6; border-radius:1.4cqw; }
        .page details { position:absolute; right:2cqw; top:2cqw; font-size:2.2cqw; max-width:60%; }
        .page details summary { cursor:pointer; background:#ececec; border-radius:1cqw; padding:.6cqw 1.6cqw; list-style:none; text-align:right; }
        .page details div { background:#fff8d9; border-radius:1.2cqw; padding:1.6cqw; margin-top:1cqw; white-space:pre-wrap; }
        .board { overflow:auto; max-width:100%; background:#fff; border-radius:4px; box-shadow:0 1px 4px #0003; }
        .board svg { width:3000px; height:2000px; display:block; }
        .pageno { text-align:center; color:var(--muted); font-size:13px; margin:-14px 0 18px; }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <header>
            <strong><a href="/Notes">JuNotes</a></strong>
            <div class="right">
                @if (User.IsInRole("admin"))
                {
                    <a href="/Admin">Admin</a>
                }
                <form method="post" asp-page="/Notes/Logout"><button type="submit">Abmelden</button></form>
            </div>
        </header>
    }
    <main>@RenderBody()</main>
</body>
</html>
