@{
    var title = ViewData["Title"] as string ?? "Admin";
}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@title · Notes</title>
    @RenderSection("Head", required: false)
    <link rel="stylesheet" href="/legacy-admin.css" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var path = Context.Request.Path.Value ?? "";
        <header>
            <strong>Notes</strong>
            <nav>
                <a href="/Admin" class="@(path == "/Admin" || path == "/Admin/" ? "on" : "")">Übersicht</a>
                <a href="/Admin/Profiles" class="@(path.StartsWith("/Admin/Profiles", StringComparison.OrdinalIgnoreCase) ? "on" : "")">KI-Profile</a>
                <a href="/Admin/Codex" class="@(path.StartsWith("/Admin/Codex", StringComparison.OrdinalIgnoreCase) ? "on" : "")">KI-Verbindung</a>
                <a href="/Admin/Backups" class="@(path.StartsWith("/Admin/Backups", StringComparison.OrdinalIgnoreCase) ? "on" : "")">Backups</a>
            </nav>
            <a href="/" class="account">Konto</a>
        </header>
    }
    <main>
        <h1>@title</h1>
        @if (TempData["Message"] is string message)
        {
            <div class="notice">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="notice bad">@error</div>
        }
        @RenderBody()
    </main>
</body>
</html>
