@{
    var title = ViewData["Title"] as string ?? "Admin";
}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@title · JuNotes</title>
    @RenderSection("Head", required: false)
    <style>
        :root { color-scheme: light dark; --bg:#f2f2f7; --card:#fff; --text:#1c1c1e; --muted:#6c6c70; --line:#d1d1d6; --accent:#007aff; --ok:#34c759; --warn:#ff9500; --bad:#ff3b30; }
        @@media (prefers-color-scheme: dark) { :root { --bg:#000; --card:#1c1c1e; --text:#f5f5f7; --muted:#98989d; --line:#38383a; --accent:#0a84ff; } }
        * { box-sizing: border-box; }
        body { margin:0; font:16px/1.5 -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif; background:var(--bg); color:var(--text); }
        header { display:flex; gap:20px; align-items:center; padding:14px 24px; background:var(--card); border-bottom:.5px solid var(--line); position:sticky; top:0; }
        header strong { font-size:18px; }
        header nav { display:flex; gap:4px; flex-wrap:wrap; }
        header a { color:var(--text); text-decoration:none; padding:6px 12px; border-radius:8px; }
        header a:hover, header a.on { background:color-mix(in srgb, var(--accent) 14%, transparent); color:var(--accent); }
        header form { margin-left:auto; }
        main { max-width:880px; margin:0 auto; padding:24px; }
        h1 { font-size:28px; margin:8px 0 20px; letter-spacing:-.02em; }
        h2 { font-size:19px; margin:0 0 4px; }
        .card { background:var(--card); border-radius:14px; padding:18px 20px; margin-bottom:16px; box-shadow:0 0 0 .5px var(--line); }
        .muted { color:var(--muted); font-size:14px; }
        .row { display:flex; justify-content:space-between; gap:16px; padding:8px 0; border-bottom:.5px solid var(--line); }
        .row:last-child { border-bottom:0; }
        label { display:block; font-weight:600; margin:14px 0 4px; font-size:14px; }
        textarea, input[type=password], input[type=text], select { width:100%; font:inherit; padding:9px 11px; border-radius:9px; border:1px solid var(--line); background:var(--bg); color:var(--text); }
        textarea { min-height:150px; resize:vertical; }
        button { font:inherit; font-weight:600; padding:8px 16px; border-radius:9px; border:0; background:var(--accent); color:#fff; cursor:pointer; }
        button.secondary { background:color-mix(in srgb, var(--accent) 14%, transparent); color:var(--accent); }
        button.danger { background:color-mix(in srgb, var(--bad) 14%, transparent); color:var(--bad); }
        .actions { display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; }
        .dot { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:6px; }
        .ok { background:var(--ok); } .warn { background:var(--warn); } .bad { background:var(--bad); }
        .code { font:600 28px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing:.08em; padding:12px 16px; background:var(--bg); border-radius:10px; display:inline-block; }
        .notice { padding:10px 14px; border-radius:10px; background:color-mix(in srgb, var(--accent) 12%, transparent); margin-bottom:16px; }
        .notice.bad { background:color-mix(in srgb, var(--bad) 12%, transparent); }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var path = Context.Request.Path.Value ?? "";
        <header>
            <strong>JuNotes</strong>
            <nav>
                <a href="/Admin" class="@(path == "/Admin" || path == "/Admin/" ? "on" : "")">Übersicht</a>
                <a href="/Admin/Profiles" class="@(path.StartsWith("/Admin/Profiles", StringComparison.OrdinalIgnoreCase) ? "on" : "")">KI-Profile</a>
                <a href="/Admin/Codex" class="@(path.StartsWith("/Admin/Codex", StringComparison.OrdinalIgnoreCase) ? "on" : "")">KI-Verbindung</a>
                <a href="/Admin/Backups" class="@(path.StartsWith("/Admin/Backups", StringComparison.OrdinalIgnoreCase) ? "on" : "")">Backups</a>
            </nav>
            <form method="post" asp-page="/Admin/Logout"><button class="secondary" type="submit">Abmelden</button></form>
        </header>
    }
    <main>
        <h1>@title</h1>
        @if (TempData["Message"] is string message)
        {
            <div class="notice">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="notice bad">@error</div>
        }
        @RenderBody()
    </main>
</body>
</html>
