@page "/Notes/{id:guid}"
@model BookModel
@{
    ViewData["Title"] = Model.Notebook?.Title ?? "Heft";
}
@if (Model.Notebook is null)
{
    <h1>Heft nicht gefunden</h1>
    <p><a href="/Notes">Zurück zu den Heften</a></p>
}
else
{
    <p class="muted"><a href="/Notes">Alle Hefte</a></p>
    <h1>@Model.Notebook.Title</h1>
    @if (Model.Pages.Count == 0)
    {
        <div class="card"><p>Dieses Heft hat noch keine Seiten.</p></div>
    }
    @if (Model.Notebook.Type == "whiteboard")
    {
        @foreach (var page in Model.Pages)
        {
            <div class="board">@Html.Raw(page.Svg)</div>
        }
    }
    else
    {
        @for (var index = 0; index < Model.Pages.Count; index++)
        {
            var page = Model.Pages[index];
            <article class="page">
                @if (page.Info.ContentType == "scan" && page.Info.AssetId is { } asset)
                {
                    <div style="aspect-ratio:595/842;position:relative"><img class="scan" src="/Notes/Asset/@asset" alt="Gescanntes Blatt" loading="lazy" /></div>
                    <div style="position:absolute;inset:0">@Html.Raw(page.Svg)</div>
                }
                else if (page.Info.ContentType == "pdf" && page.Info.AssetId is { } pdf)
                {
                    <div style="aspect-ratio:595/842;display:grid;place-items:center;background:#f5f5f5"><a href="/Notes/Asset/@pdf" target="_blank" rel="noopener noreferrer">PDF-Seite @(page.Info.PdfPageIndex + 1) öffnen</a></div>
                }
                else
                {
                    @Html.Raw(page.Svg)
                }
                @if (page.Info.Heading is { } heading)
                {
                    <div class="heading">@heading</div>
                }
                @if (page.Info.PrintedText is { } printed)
                {
                    <div class="printed">@printed</div>
                }
                @if (page.Info.Solution is { } solution)
                {
                    <details><summary>Lösung</summary><div>@solution</div></details>
                }
                @if (page.Info.Additions.Count > 0)
                {
                    <div class="additions"><strong>Ergänzungen</strong>@foreach (var addition in page.Info.Additions) { <div>@addition</div> }</div>
                }
            </article>
            <div class="pageno">Seite @(index + 1) von @Model.Pages.Count</div>
        }
    }
}
