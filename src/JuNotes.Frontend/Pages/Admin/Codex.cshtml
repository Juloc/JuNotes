@page "/Admin/Codex"
@model CodexModel
@{
    ViewData["Title"] = "KI-Verbindung";
}
@section Head {
    @if (Model.Waiting is not null)
    {
        <meta http-equiv="refresh" content="5" />
    }
}
<div class="card">
    <h2>Codex auf dem Server</h2>
    @if (!Model.Status.Installed)
    {
        <p><i class="dot bad"></i>Das Programm <code>codex</code> ist auf dem Server nicht installiert. Im Docker-Image muss es mit hinein, oder <code>Codex__Executable</code> zeigt auf den Pfad.</p>
    }
    else if (Model.Status.SignedIn)
    {
        <div class="row"><span><i class="dot ok"></i>Angemeldet</span><span>@(Model.Status.SignIn == "chatgpt" ? "mit ChatGPT" : Model.Status.SignIn == "apiKey" ? "mit API-Schlüssel" : "")</span></div>
        <div class="row"><span>Version</span><span>@Model.Status.Version</span></div>
        <form method="post" asp-page-handler="Logout"><div class="actions"><button class="danger" type="submit">Abmelden</button></div></form>
    }
    else if (Model.Waiting is { } code)
    {
        <p>Öffne diese Seite auf einem beliebigen Gerät und gib den Code ein:</p>
        <p><a href="@code.Url" target="_blank" rel="noopener noreferrer">@code.Url</a></p>
        <p><span class="code">@code.Code</span></p>
        <p class="muted">Diese Seite lädt sich selbst neu und zeigt „Angemeldet“, sobald es geklappt hat. Der Code gilt 15 Minuten.</p>
        <form method="post" asp-page-handler="Cancel"><div class="actions"><button class="secondary" type="submit">Abbrechen</button></div></form>
    }
    else
    {
        <p><i class="dot warn"></i>Nicht angemeldet. Die Lernfunktionen gehen erst, wenn der Server angemeldet ist. Du meldest dich mit dem ChatGPT-Konto an, dessen Kontingent genutzt werden soll. Das Passwort sieht der Server nie.</p>
        <form method="post" asp-page-handler="Login"><div class="actions"><button type="submit">Anmelden</button></div></form>
    }
</div>

<form method="post" class="card" asp-page-handler="Settings">
    <h2>Modell und Aufwand</h2>
    <p class="muted">Gilt für alle Aufgaben, wenn ein Profil unter „KI-Profile“ nichts Eigenes einstellt. Leer lassen heißt: Standard des Kontos.</p>
    <label>Modell</label>
    <input type="text" name="model" value="@Model.Settings.Model" placeholder="leer = Standard des Kontos" autocomplete="off" />
    <label>Aufwand (wie gründlich das Modell nachdenkt)</label>
    <select name="effort">
        <option value="" selected="@string.IsNullOrEmpty(Model.Settings.Effort)">Standard des Modells</option>
        @foreach (var level in AiSettingsRules.Efforts)
        {
            <option value="@level" selected="@(level == Model.Settings.Effort)">@AdminFormat.Effort(level)</option>
        }
    </select>
    <label>Tageslimit (Anfragen pro Tag für alle zusammen)</label>
    <input type="number" name="dailyLimit" min="1" max="@AiSettingsRules.MaxDailyLimit" value="@Model.Settings.DailyLimit" placeholder="@Model.Limit (aus der Einrichtung)" />
    <p class="muted">Höherer Aufwand gibt bessere Antworten, dauert länger und verbraucht mehr vom Kontingent des ChatGPT-Tarifs. Welche Namen es gibt, steht in Codex selbst (zum Beispiel mit <code>/model</code>).</p>
    <div class="actions"><button type="submit">Speichern</button></div>
</form>

<div class="card">
    <h2>Nutzung</h2>
    <div class="row"><span>Heute</span><span>@Model.Today.Requests von @Model.Limit Anfragen@(Model.Today.Failures > 0 ? $", {Model.Today.Failures} fehlgeschlagen" : "")</span></div>
    @foreach (var day in Model.Recent.Where(item => item.Day != Model.Today.Day))
    {
        <div class="row muted"><span>@AdminFormat.Day(day.Day)</span><span>@day.Requests Anfragen@(day.Failures > 0 ? $", {day.Failures} fehlgeschlagen" : "")</span></div>
    }
    <p class="muted">Das ist die Zählung dieses Servers. Das Kontingent deines ChatGPT-Tarifs selbst kann der Server nicht abfragen; das Tageslimit schützt davor, es zu verbrauchen.</p>
</div>
