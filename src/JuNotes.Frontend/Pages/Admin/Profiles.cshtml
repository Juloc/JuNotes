@page "/Admin/Profiles"
@model ProfilesModel
@{
    ViewData["Title"] = "KI-Profile";
}
<p class="muted">Ein Profil bestimmt, wie die KI eine Aufgabe angeht. Sie sieht in der App nur den Namen. Das Material ihrer Notizen wird immer als reine Daten übergeben, Anweisungen darin werden nicht befolgt.</p>
@foreach (var profile in Model.Profiles)
{
    <form method="post" class="card" asp-page-handler="Save">
        <h2>@profile.Name</h2>
        <input type="hidden" name="key" value="@profile.Key" />
        <label>Anweisung an die KI</label>
        <textarea name="systemPrompt">@profile.SystemPrompt</textarea>
        <label>Schwierigkeit</label>
        <select name="difficulty">
            @foreach (var option in AiDefaults.Difficulties)
            {
                <option value="@option" selected="@(option == profile.Difficulty)">@option</option>
            }
        </select>
        <label>Ton</label>
        <select name="tone">
            @foreach (var option in AiDefaults.Tones)
            {
                <option value="@option" selected="@(option == profile.Tone)">@option</option>
            }
        </select>
        <label>Modell nur für diese Aufgabe</label>
        <input type="text" name="model" value="@profile.Model" placeholder="leer = die allgemeine Einstellung" autocomplete="off" />
        <label>Aufwand nur für diese Aufgabe</label>
        <select name="effort">
            <option value="" selected="@string.IsNullOrEmpty(profile.Effort)">wie allgemein eingestellt</option>
            @foreach (var level in AiSettingsRules.Efforts)
            {
                <option value="@level" selected="@(level == profile.Effort)">@AdminFormat.Effort(level)</option>
            }
        </select>
        <label><input type="checkbox" name="enabled" value="on" checked="@profile.Enabled" /> Eingeschaltet</label>
        <div class="actions">
            <button type="submit">Speichern</button>
            <button type="submit" class="danger" asp-page-handler="Reset" formnovalidate>Auf Standard zurücksetzen</button>
        </div>
    </form>
}
